---
// src/components/home/Testimonials.astro

const logos = [
  { name: "Cummins", src: "https://cdn.brandfetch.io/idij45TXoB/theme/dark/logo.svg?c=1dxbfHSJFAPEGdCLU4o5B" },
  { name: "Graco Baby", src: "https://www.gracobaby.com/on/demandware.static/Sites-gracobaby-Site/-/default/dwb5b362a8/images/brand-logo.svg" },
  { name: "Emerson", src: "https://cdn.brandfetch.io/id1PeCaBcZ/theme/dark/logo.svg?c=1dxbfHSJFAPEGdCLU4o5B" },
  { name: "Parker Hannifin", src: "https://cdn.brandfetch.io/idebvO9NJy/theme/dark/logo.svg?c=1dxbfHSJFAPEGdCLU4o5B" },
  { name: "Eaton", src: "https://cdn.brandfetch.io/idF0_BCWLF/theme/dark/logo.svg?c=1dxbfHSJFAPEGdCLU4o5B" },
  { name: "General Mills", src: "https://cdn.brandfetch.io/idYSTGaqB-/theme/dark/logo.svg?c=1dxbfHSJFAPEGdCLU4o5B" },
  { name: "Honeywell", src: "https://cdn.brandfetch.io/id9eVV7cJp/theme/dark/logo.svg?c=1dxbfHSJFAPEGdCLU4o5B" },
  { name: "Integer", src: "https://cdn.brandfetch.io/idWH6lCB88/theme/dark/logo.svg?c=1dxbfHSJFAPEGdCLU4o5B" },
  { name: "Polaris", src: "https://cdn.brandfetch.io/idiEEAbUiD/theme/dark/logo.svg?c=1dxbfHSJFAPEGdCLU4o5B" }
];

const duplicatedLogos = [...logos, ...logos];
---

<section class="logo-carousel">
  <div class="container">
    <h2>Trusted by Industry Leaders</h2>
    
    <div class="carousel-wrapper">
      <div class="carousel-track">
        {duplicatedLogos.map((logo) => (
          <div class="logo-slide">
            <img src={logo.src} alt={`${logo.name} logo`} />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .logo-carousel {
    padding: 5rem 0;
    background-color: #ffffff;
    border-top: 1px solid #e2e8f0;
    border-bottom: 1px solid #e2e8f0;
  }

  .container h2 {
    text-align: center;
    font-size: 2rem;
    color: var(--brand-black);
    margin-top: 0;
    margin-bottom: 3.5rem;
    text-transform: uppercase;
  }

  .carousel-wrapper {
    position: relative;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
    mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
  }

  .carousel-track {
    display: flex;
    gap: 4rem;
    width: max-content;
    animation: scroll 25s linear infinite;
  }

  .carousel-wrapper:hover .carousel-track {
    animation-play-state: paused;
  }

  .logo-slide {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 200px;
  }

  .logo-slide img {
    max-width: 100%;
    height: auto;
    opacity: 0.5;
    filter: grayscale(100%);
    transition: all 0.3s ease;
  }

  .logo-slide img:hover {
    opacity: 1;
    filter: grayscale(0%);
  }

  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-50% - 2rem));
    }
  }
</style>