---
// src/components/home/Logos.astro

const logos = [
  { name: "Cummins", src: "https://cdn.brandfetch.io/idij45TXoB/theme/dark/logo.svg?c=1dxbfHSJFAPEGdCLU4o5B" },
  { name: "Graco Baby", src: "https://www.gracobaby.com/on/demandware.static/Sites-gracobaby-Site/-/default/dwb5b362a8/images/brand-logo.svg" },
  { name: "Emerson", src: "https://cdn.brandfetch.io/id1PeCaBcZ/theme/dark/logo.svg?c=1dxbfHSJFAPEGdCLU4o5B" },
  { name: "Parker Hannifin", src: "https://cdn.brandfetch.io/idebvO9NJy/theme/dark/logo.svg?c=1dxbfHSJFAPEGdCLU4o5B" },
  { name: "Eaton", src: "https://cdn.brandfetch.io/idF0_BCWLF/theme/dark/logo.svg?c=1dxbfHSJFAPEGdCLU4o5B" },
  { name: "General Mills", src: "https://cdn.brandfetch.io/idYSTGaqB-/theme/dark/logo.svg?c=1dxbfHSJFAPEGdCLU4o5B" },
  { name: "Honeywell", src: "https://cdn.brandfetch.io/id9eVV7cJp/theme/dark/logo.svg?c=1dxbfHSJFAPEGdCLU4o5B" },
  { name: "Integer", src: "https://cdn.brandfetch.io/idWH6lCB88/theme/dark/logo.svg?c=1dxbfHSJFAPEGdCLU4o5B" },
  { name: "Polaris", src: "https://cdn.brandfetch.io/idiEEAbUiD/theme/dark/logo.svg?c=1dxbfHSJFAPEGdCLU4o5B" },
  { name: "Merck", src: "https://cdn.brandfetch.io/idiLT3OaPi/theme/dark/logo.svg?c=1dxbfHSJFAPEGdCLU4o5B" },
  { name: "Solventum", src: "https://cdn.brandfetch.io/idM8AU4Kd7/theme/dark/logo.svg?c=1dxbfHSJFAPEGdCLU4o5B" },
  { name: "Nvent", src: "https://cdn.brandfetch.io/id3_tynmms/theme/dark/logo.svg?c=1dxbfHSJFAPEGdCLU4o5B" },
  { name: "Bio-Techne", src: "https://cdn.brandfetch.io/idf3ohuwly/theme/dark/logo.svg?c=1dxbfHSJFAPEGdCLU4o5B" },
  { name: "Kindeva", src: "https://cdn.brandfetch.io/id1DpJC8v7/theme/light/logo.svg?c=1dxbfHSJFAPEGdCLU4o5B" }
];

const duplicatedLogos = [...logos, ...logos];
---

<section class="logo-carousel">
  <div class="container">
    <h2>Trusted by Industry Leaders</h2>
    
    <div class="carousel-wrapper">
      <div class="carousel-track">
        {duplicatedLogos.map((logo) => (
          <div class="logo-slide">
            <img 
              src={logo.src} 
              alt={`${logo.name} logo`} 
              class={logo.name.toLowerCase().replace(/\s+/g, '-')} 
            />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .logo-carousel {
    padding: 5rem 0;
    background-color: var(--bg-light);
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
  }

  .container h2 {
    text-align: center;
    font-family: var(--font-saira);
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 800;
    color: var(--brand-black);
    margin: 0 0 3rem 0;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .carousel-wrapper {
    position: relative;
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
    mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
  }

  .carousel-track {
    display: flex;
    gap: 3.5rem;
    align-items: center;
    width: max-content;
    animation: scroll 40s linear infinite;
  }

  .carousel-wrapper:hover .carousel-track {
    animation-play-state: paused;
  }

  .logo-slide {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 170px;
    height: 60px;
  }

  .logo-slide img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    opacity: 0.6;
    filter: grayscale(100%);
    transition: all 0.3s ease;
  }

  .logo-slide img.kindeva {
    filter: brightness(0);
    opacity: 0.6;
  }

  .logo-slide img:hover {
    opacity: 1;
    filter: grayscale(0%);
  }

  .logo-slide img.kindeva:hover {
    opacity: 1;
    filter: brightness(0);
  }

  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-50% - 1.75rem));
    }
  }
</style>