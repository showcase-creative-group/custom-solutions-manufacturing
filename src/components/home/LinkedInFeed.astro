---
// src/components/home/LinkedInFeed.astro
---

<section class="linkedin-feed">
  <div class="container">
    <!-- Elfsight LinkedIn Feed | Untitled LinkedIn Feed -->
    <script is:inline src="https://elfsightcdn.com/platform.js" async></script>
    <div class="widget elfsight-app-4c52900f-007a-46dd-92db-4eb2f4018cc8" data-elfsight-app-lazy></div>
  </div>
</section>

<style>
  .linkedin-feed {
    background-color: var(--bg-light-alt);
    padding: 1.5rem 2rem;
    border-bottom: 1px solid var(--border-light);
  }

  .container {
    max-width: 1600px;
    margin: 0 auto;
    width: 100%;
  }

  .widget {
    width: 100%;
  }

  @media (max-width: 900px) {
    .linkedin-feed {
      padding: 1.5rem;
    }
  }
</style>
