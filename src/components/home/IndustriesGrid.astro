---
// src/components/home/IndustriesGrid.astro

const industries = [
  { 
    title: "FOOD", 
    desc: "Custom-grade stainless steel fabrication and sanitary automation systems for food processing."
  },
  { 
    title: "ROBOTICS", 
    desc: "Precision components and structural frames built to exact tolerances for automated systems."
  },
  { 
    title: "DEFENSE", 
    desc: "ITAR-compliant manufacturing delivering ruggedized parts for mission-critical defense applications."
  },
  { 
    title: "DATA CENTERS", 
    desc: "Heavy-duty racking, cooling enclosures, and structural supports for enterprise server farms."
  },
  { 
    title: "CONSTRUCTION", 
    desc: "Heavy-duty structural components and custom fabrication for large-scale construction projects."
  },
  { 
    title: "MEDICAL", 
    desc: "Cleanroom-compatible manufacturing of precision medical devices and surgical equipment housing."
  },
  { 
    title: "TECHNOLOGY", 
    desc: "Specialized machining and prototyping for rapid advancement in high-tech sectors."
  },
  { 
    title: "AUTOMOTIVE", 
    desc: "Scalable production of specialized automotive fixtures, tooling, and assembly line components."
  }
];
---

<section class="industries-section">
  <div class="container">
    <div class="section-header">
      <h2>Our Industries</h2>
    </div>

    <div class="grid">
      {industries.map((industry) => (
        <div class="industry-card">
          <div class="card-content">
            <h3>{industry.title}</h3>
            <p>{industry.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .industries-section {
    background-color: var(--bg-dark); 
    color: #ffffff;
    padding: 6rem 2rem;
    border-top: 1px solid var(--border-dark);
    border-bottom: 1px solid var(--border-dark);
  }

  .container {
    max-width: 1600px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .section-header h2 {
    font-family: var(--font-saira);
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 800;
    color: #ffffff;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }

  .industry-card {
    background: var(--bg-dark-card);
    border: 1px solid var(--border-dark);
    border-top: 4px solid #334155;
    display: flex;
    flex-direction: column;
    border-radius: 6px;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .industry-card:hover {
    border-color: #334155;
    border-top-color: var(--brand-blue);
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
  }

  .card-content {
    padding: 3.5rem 2.5rem;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .card-content h3 {
    margin: 0 0 1rem 0;
    font-family: var(--font-saira);
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: 1px;
    color: #ffffff;
    text-transform: uppercase;
  }

  .card-content h3::after {
    content: '';
    display: block;
    width: 40px;
    height: 3px;
    background-color: var(--brand-blue);
    margin-top: 1rem;
    border-radius: 2px;
    transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .industry-card:hover h3::after {
    width: 60px;
  }

  .card-content p {
    font-size: 1.05rem;
    color: var(--brand-gray);
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 992px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 576px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>