---
// src/components/home/FeatureSplit.astro
---

<section class="feature-overlay">
  <div class="container">
    <div class="content-box">
      <h2>Precision Built</h2>
      <h3>Decades of Manufacturing Excellence</h3>
      <p>
        Founded in 1994, Custom Solutions Manufacturing remains the manufacturer of choice for a variety of customers. 
        Our 30,000 square foot, multi-functional facility allows our valued employees to assist customers conceptualize, develop, and optimize their unique applications.
      </p>
      <a href="/contact" class="btn">Learn More</a>
    </div>
  </div>
</section>

<style>
  .feature-overlay {
    background-image: url('https://images.unsplash.com/photo-1717386255773-1e3037c81788?q=80&w=1170&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    min-height: 600px;
    display: flex;
    align-items: center; 
    padding: 6rem 2rem;
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
  }

  .container {
    max-width: 1600px;
    width: 100%;
    margin: 0 auto;
    display: flex;
    justify-content: flex-end; 
  }

  .content-box {
    background-color: var(--bg-light); 
    padding: 3.5rem 3rem;
    border-radius: 4px;
    border-left: 5px solid var(--brand-blue);
    max-width: 580px;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
  }

  .content-box h2 {
    font-family: var(--font-saira);
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 800;
    color: var(--brand-black);
    margin-top: 0;
    margin-bottom: 0.25rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    line-height: 1.1;
  }

  .content-box h3 {
    font-family: var(--font-saira);
    font-size: 1.25rem;
    color: var(--brand-blue);
    margin-top: 0.5rem;
    margin-bottom: 1.5rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .content-box p {
    font-size: 1.05rem;
    color: var(--brand-gray);
    line-height: 1.7;
    margin: 0 0 2rem 0;
  }

  .btn {
    display: inline-block;
    font-family: var(--font-saira);
    background-color: var(--brand-blue);
    color: #ffffff;
    padding: 0.85rem 1.75rem;
    text-decoration: none;
    font-weight: 700;
    border-radius: 4px;
    text-transform: uppercase;
    font-size: 0.95rem;
    letter-spacing: 0.5px;
    transition: all 0.3s ease;
  }

  .btn:hover {
    background-color: var(--brand-blue-hover);
    transform: translateY(-2px);
  }

  @media (max-width: 900px) {
    .feature-overlay {
      padding: 4rem 1.5rem;
    }
    
    .container {
      justify-content: center;
    }
    
    .content-box {
      max-width: 100%;
      padding: 2.5rem 1.5rem;
    }

    .btn {
      display: block;
      width: 100%;
      box-sizing: border-box;
      text-align: center;
    }
  }
</style>