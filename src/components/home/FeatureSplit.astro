---
// src/components/home/FeatureSplit.astro
---

<section class="feature-overlay">
  <div class="container">
    <div class="content-box">
      <h2>Title</h2>
      <h3>Subtitle</h3>
      <p>
        Founded in 1994, Custom Solutions Manufacturing remains the manufacturer of choice for a variety of customers. 
Our 30,000 square foot, multi-functional facility allows our valued employees to assist customers conceptualize, develop, and optimize their unique applications. 
      </p>
      <a href="/contact" class="btn">Learn More</a>
    </div>
  </div>
</section>

<style>
  .feature-overlay {
    background-image: url('https://images.unsplash.com/photo-1717386255773-1e3037c81788?q=80&w=1170&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    min-height: 600px;
    display: flex;
    align-items: flex-end; 
    padding: 4rem 2rem;
  }

  .container {
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    display: flex;
    justify-content: flex-end; 
  }

  .content-box {
    background-color: #ffffff; 
    padding: 3rem;
    border-radius: 4px;
    border-left: 4px solid var(--brand-blue);
    max-width: 550px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    transform: translateY(2rem); 
  }

  .content-box h2 {
    font-size: 2.5rem;
    color: var(--brand-black);
    margin-top: 0;
    margin-bottom: 0.25rem;
    text-transform: uppercase;
  }

  .content-box h3 {
    font-size: 1.25rem;
    color: var(--brand-blue);
    margin-top: 0;
    margin-bottom: 1.5rem;
    font-weight: 600;
  }

  .content-box p {
    font-size: 1.05rem;
    color: var(--brand-gray);
    line-height: 1.7;
    margin: 0 0 1.5rem 0;
  }

  .btn {
    display: inline-block;
    background-color: var(--brand-blue);
    color: #ffffff;
    padding: 0.75rem 1.5rem;
    text-decoration: none;
    font-weight: 600;
    border-radius: 4px;
    text-transform: uppercase;
    font-size: 0.9rem;
    letter-spacing: 0.5px;
    transition: opacity 0.2s ease;
  }

  .btn:hover {
    opacity: 0.85; /* Soft fade on hover to avoid clashing with the brand blue */
  }

  @media (max-width: 768px) {
    .container {
      justify-content: center;
    }
    .content-box {
      transform: translateY(0);
      padding: 2rem;
    }
  }
</style>