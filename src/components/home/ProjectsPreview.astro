---
// src/components/home/ProjectsPreview.astro
---

<section class="projects-preview">
  <div class="container">
    <div class="header-content">
      <div class="text-group">
        <h2>Projects</h2>
        <p>Review our recent custom manufacturing builds and turnkey system integrations.</p>
      </div>
      <a href="/projects" class="btn">Explore All Projects</a>
    </div>

    <div class="projects-grid">
      <a href="/projects/case-study-1" class="project-card">
        <div class="image-wrapper">
          <img src="https://images.unsplash.com/photo-1716194583732-0b9874234218?q=80&w=1170&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" alt="Project Alpha" loading="lazy" />
          <div class="overlay">
            <h3>Automated Conveyor System</h3>
            <span>View Case Study &rarr;</span>
          </div>
        </div>
      </a>

      <a href="/projects/case-study-2" class="project-card">
        <div class="image-wrapper">
          <img src="https://plus.unsplash.com/premium_photo-1661963536116-543d5014d872?w=600&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTN8fGFlcm9zcGFjZSUyMGNvbXBvbmVudHN8ZW58MHx8MHx8fDA%3D" alt="Project Beta" loading="lazy" />
          <div class="overlay">
            <h3>Titanium Aerospace Components</h3>
            <span>View Case Study &rarr;</span>
          </div>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  .projects-preview {
    padding: 6rem 2rem;
    background-color: var(--bg-light);
  }

  .container {
    max-width: 1600px;
    margin: 0 auto;
  }

  .header-content {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 3.5rem;
    padding-bottom: 1rem;
  }

  .text-group h2 {
    font-family: var(--font-saira);
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 800;
    color: var(--brand-black);
    margin-top: 0;
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .text-group h2::after {
    content: "";
    display: block;
    width: 60px;
    height: 4px;
    background-color: var(--brand-blue);
    margin-top: 1.25rem;
    border-radius: 2px;
  }

  .text-group p {
    font-size: clamp(1.1rem, 2vw, 1.25rem);
    color: var(--brand-gray);
    margin: 0;
    max-width: 600px;
    line-height: 1.6;
  }

  .btn {
    display: inline-block;
    font-family: var(--font-saira);
    background-color: var(--brand-blue);
    color: #ffffff;
    padding: 0.85rem 1.75rem;
    text-decoration: none;
    font-weight: 700;
    border-radius: 4px;
    text-transform: uppercase;
    font-size: 0.95rem;
    letter-spacing: 0.5px;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .btn:hover {
    background-color: var(--brand-blue-hover);
    transform: translateY(-2px);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr); 
    gap: 2rem;
  }

  .project-card {
    display: block;
    text-decoration: none;
    overflow: hidden;
    border-radius: 6px;
    position: relative;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    transition: box-shadow 0.4s ease;
  }

  .project-card:hover {
    box-shadow: 0 20px 40px rgba(0,0,0,0.15);
  }

  .image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
  }

  .image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 3rem 2.5rem;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.95) 0%, rgba(0, 0, 0, 0.4) 60%, transparent 100%);
    color: #ffffff;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .overlay h3 {
    margin: 0 0 0.5rem 0;
    font-family: var(--font-saira);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    transform: translateY(10px);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .overlay span {
    font-size: 1rem;
    font-weight: 600;
    color: var(--brand-blue);
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-card:hover .image-wrapper img {
    transform: scale(1.08);
  }

  .project-card:hover .overlay h3 {
    transform: translateY(0);
  }

  .project-card:hover .overlay span {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 992px) {
    .header-content {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
    }
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>