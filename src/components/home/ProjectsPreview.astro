---
// src/components/home/ProjectsPreview.astro
---

<section class="projects-preview">
  <div class="container">
    <div class="header-content">
      <div class="text-group">
        <h2>Projects</h2>
        <p>Review our recent custom manufacturing builds and turnkey system integrations.</p>
      </div>
      <a href="/projects" class="btn">Explore All Projects</a>
    </div>

    <div class="projects-grid">
      <a href="/projects/case-study-1" class="project-card">
        <div class="image-wrapper">
          <img src="https://images.unsplash.com/photo-1716194583732-0b9874234218?q=80&w=1170&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" alt="Project Alpha" />
          <div class="overlay">
            <h3>Automated Conveyor System</h3>
            <span>View Case Study &rarr;</span>
          </div>
        </div>
      </a>

      <a href="/projects/case-study-2" class="project-card">
        <div class="image-wrapper">
          <img src="https://plus.unsplash.com/premium_photo-1661963536116-543d5014d872?w=600&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTN8fGFlcm9zcGFjZSUyMGNvbXBvbmVudHN8ZW58MHx8MHx8fDA%3D" alt="Project Beta" />
          <div class="overlay">
            <h3>Titanium Aerospace Components</h3>
            <span>View Case Study &rarr;</span>
          </div>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  .projects-preview {
    padding: 6rem 2rem;
    background-color: #ffffff;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .header-content {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 3rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid #e2e8f0;
  }

  .text-group h2 {
    font-size: 2.5rem;
    color: var(--brand-black);
    margin-top: 0;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
  }

  .text-group p {
    font-size: 1.1rem;
    color: var(--brand-gray);
    margin: 0;
    max-width: 500px;
  }

  .btn {
    display: inline-block;
    background-color: var(--brand-blue);
    color: #ffffff;
    padding: 0.75rem 1.5rem;
    text-decoration: none;
    font-weight: 600;
    border-radius: 4px;
    text-transform: uppercase;
    font-size: 0.9rem;
    letter-spacing: 0.5px;
    transition: opacity 0.2s ease;
    white-space: nowrap;
  }

  .btn:hover {
    opacity: 0.85;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr); 
    gap: 2rem;
  }

  .project-card {
    display: block;
    text-decoration: none;
    overflow: hidden;
    border-radius: 4px;
    position: relative;
  }

  .image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3; 
  }

  .image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 2rem;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.9), transparent);
    color: #ffffff;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .overlay h3 {
    margin: 0 0 0.5rem 0;
    font-size: 1.5rem;
    transform: translateY(10px);
    transition: transform 0.3s ease;
  }

  .overlay span {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--brand-blue);
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.3s ease;
  }

  .project-card:hover .image-wrapper img {
    transform: scale(1.05);
  }

  .project-card:hover .overlay h3 {
    transform: translateY(0);
  }

  .project-card:hover .overlay span {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 768px) {
    .header-content {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
    }
    
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>