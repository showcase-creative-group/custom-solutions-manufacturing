---
// src/components/home/ProjectsPreview.astro
---

<section class="projects-preview">
  <div class="container">
    <div class="header-content">
      <div class="text-group">
        <h2>PROJECTS</h2>
        <p>Review our recent custom manufacturing builds and turnkey system integrations.</p>
      </div>
      <a href="/projects" class="btn">Explore All Projects &rarr;</a>
    </div>

    <div class="projects-grid">
      <a href="/projects" class="project-card">
        <div class="visual-frame">
          <div class="corner-cross top-left">+</div>
          <div class="corner-cross top-right">+</div>
          <div class="corner-cross bottom-left">+</div>
          <div class="corner-cross bottom-right">+</div>

          <img src="https://images.unsplash.com/photo-1716194583732-0b9874234218?q=80&w=1170&auto=format&fit=crop&ixlib=rb-4.1.0" alt="Automated Conveyor System" loading="lazy" />
          
          <div class="overlay-content">
            <h3>Automated Conveyor System</h3>
          </div>
        </div>
      </a>

      <a href="/projects" class="project-card">
        <div class="visual-frame">
          <div class="corner-cross top-left">+</div>
          <div class="corner-cross top-right">+</div>
          <div class="corner-cross bottom-left">+</div>
          <div class="corner-cross bottom-right">+</div>

          <img src="https://plus.unsplash.com/premium_photo-1661963536116-543d5014d872?w=600&auto=format&fit=crop&q=60&ixlib=rb-4.1.0" alt="Titanium Aerospace Components" loading="lazy" />
          
          <div class="overlay-content">
            <h3>Titanium Aerospace Components</h3>
          </div>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  .projects-preview {
    padding: 6rem 2rem;
    background-color: var(--bg-light);
  }

  .container {
    max-width: 1600px;
    margin: 0 auto;
    width: 100%;
  }

  .header-content {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 3rem;
  }

  .text-group h2 {
    font-family: var(--font-saira);
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 800;
    color: var(--brand-black);
    margin: 0 0 1rem 0;
    text-transform: uppercase;
    line-height: 1.05;
    letter-spacing: -0.5px;
  }

  .text-group p {
    font-size: 1.1rem;
    color: var(--brand-gray);
    margin: 0;
    max-width: 600px;
    line-height: 1.6;
  }

  .btn {
    display: inline-block;
    font-family: var(--font-saira);
    background-color: var(--brand-blue);
    color: var(--bg-light);
    padding: 0.9rem 1.75rem;
    text-decoration: none;
    font-weight: 700;
    border-radius: 2px;
    text-transform: uppercase;
    font-size: 0.9rem;
    letter-spacing: 1px;
    transition: background-color 0.2s ease;
    white-space: nowrap;
  }

  .btn:hover {
    background-color: var(--brand-blue-hover);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .project-card {
    display: block;
    text-decoration: none;
    position: relative;
    border-radius: 2px;
    overflow: hidden;
  }

  .visual-frame {
    position: relative;
    background-color: var(--brand-black);
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--border-light);
  }

  .visual-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .project-card:hover .visual-frame img {
    transform: scale(1.05);
  }

  .corner-cross {
    position: absolute;
    font-family: var(--font-saira);
    font-size: 0.85rem;
    color: var(--brand-blue);
    font-weight: bold;
    z-index: 3;
    pointer-events: none;
  }

  .top-left { top: 8px; left: 10px; }
  .top-right { top: 8px; right: 10px; }
  .bottom-left { bottom: 8px; left: 10px; }
  .bottom-right { bottom: 8px; right: 10px; }

  .overlay-content {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.85);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    text-align: center;
    z-index: 2;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .project-card:hover .overlay-content {
    opacity: 1;
  }

  .overlay-content h3 {
    font-family: var(--font-saira);
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-weight: 800;
    color: var(--bg-light);
    text-transform: uppercase;
    margin: 0;
    line-height: 1.2;
    letter-spacing: 0.5px;
  }

  @media (max-width: 900px) {
    .header-content {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
    }

    .projects-grid {
      grid-template-columns: 1fr;
    }

    .overlay-content {
      opacity: 1;
      background-color: rgba(0, 0, 0, 0.7);
      padding: 1.5rem;
    }
  }
</style>