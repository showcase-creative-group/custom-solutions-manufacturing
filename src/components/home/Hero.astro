---
// src/components/home/Hero.astro
---

<section class="hero-section">
  <!-- Cloudflare R2 Video Background -->
  <video class="hero-video" autoplay loop muted playsinline>
    <source src="https://pub-6b61e64b6d9145a3b0f5e845de93fbb9.r2.dev/Home/csm_hero_manufacturing_portfolio_for_web.mp4" type="video/mp4" />
  </video>
  
  <!-- Lighter Gradient Overlay -->
  <div class="hero-overlay"></div>

  <div class="hero-container">
    <h1>Turn-Key, Specialized<br>Manufacturing</h1>
    <p>Discover precision machining and custom welding to serve your needs.</p>
  </div>
</section>

<style>
  .hero-section {
    background-color: var(--bg-dark); 
    color: #ffffff;
    
    width: 100%;
    min-height: 100vh;
    box-sizing: border-box;
    
    display: flex;
    align-items: center;
    
    padding: 120px 2rem 5rem 2rem;
    position: relative;
    overflow: hidden;
  }

  .hero-video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.6));
    z-index: 2;
  }

  /* Expanded from 1200px to 1600px to match all homepage grid components */
  .hero-container {
    max-width: 1600px;
    margin: 0 auto;
    width: 100%;
    position: relative;
    z-index: 3;
    /* Layered shadows for better separation from the video */
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.6), 0 10px 20px rgba(0, 0, 0, 0.4);
  }

  h1 {
    font-family: var(--font-saira);
    font-size: clamp(2.5rem, 5vw, 4.5rem); 
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1.1;
    margin-bottom: 1.25rem;
    max-width: 850px; /* Constrained to preserve optimal reading line-length */
    color: #ffffff;
    letter-spacing: -0.5px;
    /* Smooth fade-in animation */
    opacity: 0;
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  /* The Brand Accent Line */
  h1::after {
    content: "";
    display: block;
    width: 80px;
    height: 5px;
    background-color: var(--brand-blue);
    margin-top: 1.5rem;
    border-radius: 2px;
  }

  p {
    font-size: clamp(1.15rem, 2vw, 1.35rem); 
    font-weight: 500; 
    max-width: 600px; /* Constrained to preserve optimal reading line-length */
    color: rgba(255, 255, 255, 0.95);
    margin: 0;
    line-height: 1.6;
    letter-spacing: 0.3px; 
    /* Staggered animation delay */
    opacity: 0;
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.15s forwards;
  }

  /* Animation Keyframes */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .hero-section {
      padding-top: 100px;
      min-height: 80vh;
    }
  }
</style>