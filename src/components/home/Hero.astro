---
// src/components/home/Hero.astro
---

<section class="hero-section">
  <video class="hero-video" autoplay loop muted playsinline>
    <source src="https://pub-6b61e64b6d9145a3b0f5e845de93fbb9.r2.dev/Home/csm_hero_manufacturing_portfolio_for_web.mp4" type="video/mp4" />
  </video>
  
  <div class="hero-overlay"></div>
  <div class="video-dot-matrix"></div>

  <div class="hero-container">
    <div class="hud-frame">
      <div class="hud-bracket top-left"></div>
      <div class="hud-bracket top-right"></div>
      <div class="hud-bracket bottom-left"></div>
      <div class="hud-bracket bottom-right"></div>

      <h1>TURN-KEY<br/>SPECIALIZED<br/>MANUFACTURING</h1>
      <p>Discover precision machining and custom welding to serve your needs.</p>
    </div>
  </div>
</section>

<style>
  .hero-section {
    background-color: var(--bg-dark); 
    color: #ffffff;
    width: 100%;
    min-height: 100vh;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    padding: 120px 2rem 5rem 2rem;
    position: relative;
    overflow: hidden;
  }

  .hero-video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0.2) 100%);
    z-index: 2;
  }

  .video-dot-matrix {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: radial-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 24px 24px;
    z-index: 3;
  }

  .hero-container {
    max-width: 1600px;
    margin: 0 auto;
    width: 100%;
    position: relative;
    z-index: 4;
  }

  .hud-frame {
    position: relative;
    padding: 3rem;
    max-width: 850px;
    opacity: 0;
    animation: hudFadeIn 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .hud-bracket {
    position: absolute;
    width: 40px;
    height: 40px;
    border-color: var(--brand-blue);
    border-style: solid;
  }

  .top-left { top: 0; left: 0; border-width: 3px 0 0 3px; }
  .top-right { top: 0; right: 0; border-width: 3px 3px 0 0; }
  .bottom-left { bottom: 0; left: 0; border-width: 0 0 3px 3px; }
  .bottom-right { bottom: 0; right: 0; border-width: 0 3px 3px 0; }

  h1 {
    font-family: var(--font-saira);
    font-size: clamp(3rem, 6vw, 5rem); 
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1.05;
    margin: 0 0 1.5rem 0;
    color: #ffffff;
    letter-spacing: -1px;
    text-shadow: 0 4px 12px rgba(0, 0, 0, 0.8);
  }

  p {
    font-size: clamp(1.15rem, 2vw, 1.35rem); 
    font-weight: 500; 
    max-width: 600px; 
    color: rgba(255, 255, 255, 0.95);
    line-height: 1.6;
    letter-spacing: 0.3px; 
    margin: 0;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.8);
  }

  @keyframes hudFadeIn {
    from {
      opacity: 0;
      transform: scale(0.98) translateY(10px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  @media (max-width: 900px) {
    .hero-section {
      padding: 100px 1.5rem 4rem 1.5rem;
      min-height: 80vh;
    }

    .hud-frame {
      padding: 2rem 1.5rem;
    }

    .hud-bracket {
      width: 25px;
      height: 25px;
    }
  }
</style>