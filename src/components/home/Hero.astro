---
// src/components/home/Hero.astro
---

<section class="hero-section">
  <!-- Cloudflare R2 Video Background -->
  <video class="hero-video" autoplay loop muted playsinline>
    <source src="https://pub-6b61e64b6d9145a3b0f5e845de93fbb9.r2.dev/Home/csm_hero_manufacturing_portfolio_for_web.mp4" type="video/mp4" />
  </video>
  
  <!-- Lighter Gradient Overlay -->
  <div class="hero-overlay"></div>

  <div class="hero-container">
    <h1>TURN-KEY<br/>SPECIALIZED<br/>MANUFACTURING</h1>
    <p>Discover precision machining and custom welding to serve your needs.</p>
  </div>
</section>

<style>
  .hero-section {
    background-color: var(--bg-dark); 
    color: #ffffff;
    
    width: 100%;
    min-height: 100vh;
    box-sizing: border-box;
    
    display: flex;
    align-items: center;
    
    padding: 120px 2rem 5rem 2rem;
    position: relative;
    overflow: hidden;
  }

  .hero-video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.6));
    z-index: 2;
  }

  .hero-container {
    max-width: 1600px;
    margin: 0 auto;
    width: 100%;
    position: relative;
    z-index: 3;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.6), 0 10px 20px rgba(0, 0, 0, 0.4);
  }

  h1 {
    font-family: var(--font-saira);
    font-size: clamp(2.5rem, 5vw, 4.5rem); 
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1.1;
    margin-bottom: 2rem; /* Adjusted for better spacing to the box */
    max-width: 850px; 
    color: #ffffff;
    letter-spacing: -0.5px;
    opacity: 0;
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  p {
    font-size: clamp(1.15rem, 2vw, 1.35rem); 
    font-weight: 500; 
    max-width: 600px; 
    color: rgba(255, 255, 255, 0.95);
    margin: 0;
    line-height: 1.6;
    letter-spacing: 0.3px; 
    
    /* Box Styling */
    background-color: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-left: 4px solid var(--brand-blue);
    padding: 1.5rem 2rem;
    border-radius: 0 4px 4px 0;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    
    opacity: 0;
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.15s forwards;
  }

  /* Animation Keyframes */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 900px) {
    .hero-section {
      padding: 100px 1.5rem 4rem 1.5rem;
      min-height: 80vh;
    }
    
    p {
      padding: 1.25rem 1.5rem;
    }
  }
</style>