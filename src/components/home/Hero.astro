---
// src/components/home/Hero.astro
---

<section class="hero-section">
  <!-- Cloudflare R2 Video Background -->
  <video class="hero-video" autoplay loop muted playsinline>
    <source src="https://pub-6b61e64b6d9145a3b0f5e845de93fbb9.r2.dev/Home/csm_hero_manufacturing_portfolio_for_web.mp4" type="video/mp4" />
  </video>
  
  <!-- Lighter Gradient Overlay -->
  <div class="hero-overlay"></div>

  <div class="hero-container">
    <h1>Turn-Key, Specialized<br>Manufacturing</h1>
    <p>Discover precision machining and custom welding to serve your needs.</p>
  </div>
</section>

<style>
  .hero-section {
    background-color: var(--brand-black); 
    color: #ffffff;
    
    /* Full viewport height to match the edge-to-edge industrial scale */
    width: 100%;
    min-height: 100vh;
    box-sizing: border-box;
    
    display: flex;
    align-items: center;
    
    /* Top padding accounts for the fixed overlay navbar */
    padding: 120px 2rem 5rem 2rem;
    
    /* Required to contain the absolutely positioned video */
    position: relative;
    overflow: hidden;
  }

  /* Video styling to act like a cover background */
  .hero-video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  /* Refactored overlay: Lighter gradient (40% to 60% black) */
  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    /* Changed from 0.75/0.85 to 0.4/0.6 */
    background: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.6));
    z-index: 2;
  }

  .hero-container {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    /* Keep text above the video and overlay */
    position: relative;
    z-index: 3;
    /* Optional: Add a subtle text shadow to ensure legibility over lighter video sections */
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
  }

  h1 {
    font-family: var(--font-saira);
    font-size: clamp(2.5rem, 5vw, 4.5rem); 
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    max-width: 800px;
    color: #ffffff;
    letter-spacing: -0.5px;
  }

  p {
    font-size: clamp(1.1rem, 2vw, 1.25rem);
    max-width: 600px;
    color: var(--brand-gray);
    margin: 0;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .hero-section {
      padding-top: 100px;
      min-height: 80vh;
    }
  }
</style>