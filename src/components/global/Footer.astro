---
// src/components/global/Footer.astro
const currentYear = new Date().getFullYear();
---

<footer>
  <div class="container">
    
    <div class="footer-col brand-col">
      <h3>Custom Solutions</h3>
      <p class="description">
        Custom-engineered manufacturing solutions solving one-of-a-kind industrial challenges at highly competitive prices.<br><br>
        CSM specializes in custom automation, precision machining, and turnkey systems integration.
      </p>
      
      <div class="contact-info">
        <div class="contact-item">
          <span class="label">OFFICE</span>
          <span class="value">Minnesota, USA</span>
        </div>
        <div class="contact-item">
          <span class="label">PHONE</span>
          <a href="tel:5551234567" class="phone-link">(555) 123-4567</a>
        </div>
        <div class="contact-item">
          <span class="label">SOCIAL</span>
          <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="LinkedIn">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class="footer-col">
      <h4>COMPANY</h4>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/what-we-do">What We Do</a></li>
        <li><a href="/industries">Industries</a></li>
        <li><a href="/projects">Projects</a></li>
        <li><a href="/contact">Contact Us</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h4>CORE SERVICES</h4>
      <ul>
        <li><a href="/what-we-do#engineering">Engineering & Design</a></li>
        <li><a href="/what-we-do#manufacturing">Precision Manufacturing</a></li>
        <li><a href="/what-we-do#automation">Automation & Controls</a></li>
        <li><a href="/what-we-do#assembly">Assembly & Integration</a></li>
        <li><a href="/what-we-do#specialized">Specialized Services</a></li>
        <li><a href="/what-we-do#machine">Machine Services</a></li>
      </ul>
    </div>

  </div>
  
  <div class="bottom-bar">
    <div class="bottom-container">
      <p>&copy; {currentYear} Custom Solutions Manufacturing. All rights reserved.</p>
      
      <div class="credit">
        <span>Developed by</span> 
        <a href="#" target="_blank" rel="noopener noreferrer" class="credit-link">
          Showcase Creative Group
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer {
    background-color: var(--brand-black);
    color: #ffffff;
    padding-top: 5rem;
    border-top: 1px solid #1f2937;
    margin-top: auto;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem 4rem 1.5rem;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 4rem;
  }

  h3 {
    font-family: var(--font-saira);
    margin-top: 0;
    font-size: 1.5rem;
    font-weight: 800;
    margin-bottom: 1rem;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }
  
  .description {
    color: var(--brand-gray);
    line-height: 1.6;
    max-width: 380px;
    margin-bottom: 2rem;
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .contact-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 1.1rem;
  }

  .label {
    font-family: var(--font-saira);
    font-size: 0.75rem;
    font-weight: 700;
    color: #ffffff;
    background: var(--brand-blue);
    padding: 2px 6px;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 1px;
    min-width: 60px;
    text-align: center;
  }

  .value {
    color: #ffffff;
    font-weight: 500;
  }

  .phone-link, .social-link {
    color: #ffffff;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s ease;
    display: flex;
    align-items: center;
  }

  .phone-link:hover, .social-link:hover {
    color: var(--brand-blue);
  }

  h4 {
    font-family: var(--font-saira);
    color: var(--brand-gray);
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 1.25rem;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  li {
    margin-bottom: 0.75rem;
  }

  a {
    color: #ffffff;
    text-decoration: none;
    transition: all 0.2s ease;
    font-size: 1.05rem;
  }

  .footer-col ul a:hover {
    color: var(--brand-blue);
    padding-left: 4px;
  }

  .bottom-bar {
    background-color: var(--brand-black);
    padding: 1.5rem 0;
    font-size: 0.9rem;
    color: var(--brand-gray);
    border-top: 1px solid #1f2937;
  }

  .bottom-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .bottom-container p {
    margin: 0;
  }

  .credit {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .credit-link {
    color: #ffffff;
    font-weight: 600;
    font-size: 0.9rem;
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    transition: color 0.2s ease;
  }
  
  .credit-link:hover {
    color: var(--brand-blue);
  }

  /* Mobile Breakpoint */
  @media (max-width: 992px) {
    .container {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .bottom-container {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }

    .credit {
      justify-content: center;
    }
    
    .contact-item {
        font-size: 1rem;
    }
  }
</style>