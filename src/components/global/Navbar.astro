---
// src/components/global/Navbar.astro

const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '/index.html';

const isActive = (path) => {
  return (pathname === path || pathname === path + '/') ? "active" : "";
};
---
<header id="main-header" class={isHome ? "is-home top-of-page" : ""}>
  <nav>
    <div class="logo">
      <a href="/">CSM Logo</a>
    </div>
    
    <div class="nav-actions">
      <ul class="nav-links">
        <li><a href="/what-we-do" class={isActive('/what-we-do')}>What We Do</a></li>
        <li><a href="/industries" class={isActive('/industries')}>Industries</a></li>
        <li><a href="/projects" class={isActive('/projects')}>Projects</a></li>
      </ul>
      <a href="/contact" class="nav-cta">Get a Quote</a>
    </div>
  </nav>
</header>

<style>
  header {
    background-color: #ffffff;
    padding: 1rem 2rem;
    border-bottom: 1px solid #e2e8f0;
    position: sticky;
    top: 0;
    z-index: 1000;
    width: 100%;
    box-sizing: border-box;
    transition: transform 0.3s ease-in-out, background-color 0.3s ease, border-color 0.3s ease;
  }

  header.is-home {
    position: fixed;
  }

  header.is-home.top-of-page {
    background-color: transparent;
    border-bottom-color: transparent;
  }

  header.nav-hidden {
    transform: translateY(-100%);
  }

  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
  }

  .logo a {
    font-family: var(--font-saira);
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--brand-black);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: color 0.3s ease;
  }

  header.is-home.top-of-page .logo a {
    color: #ffffff;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 2.5rem;
  }

  .nav-links {
    list-style: none;
    display: flex;
    gap: 2rem;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    font-family: var(--font-saira);
    text-decoration: none;
    color: var(--brand-black);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.95rem;
    letter-spacing: 0.5px;
    transition: color 0.3s ease;
  }

  header.is-home.top-of-page .nav-links a {
    color: #ffffff;
  }

  .nav-links a:hover,
  .nav-links a.active {
    color: var(--brand-blue);
  }

  .nav-cta {
    font-family: var(--font-saira);
    background-color: var(--brand-blue);
    color: #ffffff;
    padding: 0.65rem 1.5rem;
    text-decoration: none;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.9rem;
    letter-spacing: 0.5px;
    border-radius: 4px;
    transition: opacity 0.2s ease;
    white-space: nowrap;
  }

  .nav-cta:hover {
    opacity: 0.85;
  }
</style>

<script>
  let lastScrollY = window.scrollY;
  const header = document.getElementById('main-header');

  window.addEventListener('scroll', () => {
    const currentScrollY = window.scrollY;
    
    if (currentScrollY > 50) {
      header.classList.remove('top-of-page');
    } else {
      header.classList.add('top-of-page');
    }
    
    if (currentScrollY > lastScrollY && currentScrollY > 100) {
      header.classList.add('nav-hidden');
    } else {
      header.classList.remove('nav-hidden');
    }
    
    lastScrollY = currentScrollY;
  }, { passive: true });
</script>