---
import Layout from '../layouts/Layout.astro';

const serviceGroups = [
  {
    id: "engineering",
    code: "CAP-01",
    title: "Engineering & Design",
    tagline: "Mechanical Conceptualization",
    description: "Translating complex performance requirements into production-ready 3D CAD models, custom machine designs, and functional prototypes.",
    capabilities: [
      "Mechanical Design (3D CAD)",
      "Custom Machine Design",
      "Design for Manufacturability",
      "Prototyping & 3D Printing"
    ],
    image: "https://placehold.co/800x600/050505/ffffff?text=Engineering+%26+Design"
  },
  {
    id: "manufacturing",
    code: "CAP-02",
    title: "Precision Manufacturing",
    tagline: "High-Tolerance Component Fabrication",
    description: "Advanced CNC milling, turning, and wire EDM paired with expert sheet metal fabrication and certified welding for robust component creation.",
    capabilities: [
      "CNC Milling & Turning",
      "EDM Wire Cutting",
      "MIG & TIG Welding",
      "Sheet Metal Fabrication"
    ],
    image: "https://placehold.co/800x600/050505/ffffff?text=Precision+Manufacturing"
  },
  {
    id: "automation",
    code: "CAP-03",
    title: "Automation & Controls",
    tagline: "Industrial Robotics & UL Panels",
    description: "Designing custom control panels, programming PLCs, and integrating robotic systems to optimize cycle times and industrial automation workflows.",
    capabilities: [
      "Control Panel Design & UL 508A Panels",
      "PLC & Controls Programming",
      "Robotic Integration",
      "Industrial Automation"
    ],
    image: "https://placehold.co/800x600/050505/ffffff?text=Automation+%26+Controls"
  },
  {
    id: "assembly",
    code: "CAP-04",
    title: "Assembly & Integration",
    tagline: "Turnkey Machine Building",
    description: "Comprehensive mechanical and electrical assembly, complete machine wiring, and full turnkey system integration from our floor to yours.",
    capabilities: [
      "Mechanical & Electrical Assembly",
      "Machine Wiring",
      "Turnkey System Integration",
      "Packaging & Shipping"
    ],
    image: "https://placehold.co/800x600/050505/ffffff?text=Assembly+%26+Integration"
  },
  {
    id: "specialized",
    code: "CAP-05",
    title: "Specialized Services",
    tagline: "Tooling, Fixtures & Compliance",
    description: "Providing expert tool and die making, custom fixture engineering, laser marking, and ITAR-registered compliance for specialized defense or aerospace needs.",
    capabilities: [
      "Tool & Die Making",
      "Fixture Design & Manufacturing",
      "Laser Marking & Engraving",
      "ITAR Registered"
    ],
    image: "https://placehold.co/800x600/050505/ffffff?text=Specialized+Services"
  },
  {
    id: "machine-services",
    code: "CAP-06",
    title: "Machine Services",
    tagline: "Retrofits, Rebuilds & Fluid Power",
    description: "Extending equipment lifecycles through comprehensive machine rebuilds, modern retrofits, and custom pneumatic and hydraulic system design.",
    capabilities: [
      "Machine Retrofits",
      "Pneumatic System Design",
      "Hydraulic System Design",
      "Machine Rebuilds"
    ],
    image: "https://placehold.co/800x600/050505/ffffff?text=Machine+Services"
  }
];
---

<Layout title="What We Do | Custom Solutions Manufacturing">
  <section class="hero-section">
    <div class="container">
      <span class="eyebrow-text">CORE CAPABILITIES</span>
      <h1>ENGINEERED FOR<br/><span class="text-blue">EXTREME PERFORMANCE</span></h1>
      <p class="hero-desc">
        End-to-end custom manufacturing, spanning 6 specialized capability groups built to handle single prototypes up to high-volume turnkey systems.
      </p>
    </div>
  </section>

  <div class="showcase-wrapper">
    {serviceGroups.map((group, index) => (
      <section id={group.id} class={`capability-row ${index % 2 === 0 ? 'bg-white' : 'bg-slate'}`}>
        <div class={`container split-grid ${index % 2 !== 0 ? 'reverse' : ''}`}>
          
          <div class="content-col">
            <div class="title-block">
              <span class="code-badge">{group.code}</span>
              <span class="spec-tag">{group.tagline}</span>
            </div>
            
            <h2>{group.title}</h2>
            <p class="description">{group.description}</p>
            
            <div class="specs-box">
              <div class="specs-header">CAPABILITIES</div>
              <ul class="specs-list">
                {group.capabilities.map((cap) => (
                  <li><span class="bullet"></span>{cap}</li>
                ))}
              </ul>
            </div>

            <a href="/contact" class="tactical-btn">
              <span>DISCUSS {group.title.split(" ")[0].toUpperCase()}</span>
              <span class="btn-arrow">&rarr;</span>
            </a>
          </div>

          <div class="image-col">
            <div class="visual-frame">
              <div class="corner-cross top-left">+</div>
              <div class="corner-cross top-right">+</div>
              <div class="corner-cross bottom-left">+</div>
              <div class="corner-cross bottom-right">+</div>
              <img src={group.image} alt={group.title} loading="lazy" />
            </div>
          </div>

        </div>
      </section>
    ))}
  </div>

  <section class="bottom-callout">
    <div class="container">
      <div class="callout-box">
        <span class="eyebrow-text">READY TO BUILD?</span>
        <h2>HAVE A COMPLEX CAPABILITY REQUIREMENT?</h2>
        <p>Whether you need a single precision prototype or a fully automated turn-key production cell, our engineering team is ready to assist.</p>
        <a href="/contact" class="btn-primary">START A CONVERSATION</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero-section {
    background-color: var(--bg-dark);
    color: var(--bg-light);
    padding: 10rem 2rem 4rem 2rem;
    position: relative;
    border-bottom: 2px solid var(--brand-blue);
  }

  .eyebrow-text {
    font-family: var(--font-saira);
    color: var(--brand-gray);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 2px;
    margin-bottom: 1rem;
    display: block;
    text-transform: uppercase;
  }

  .hero-section h1 {
    font-family: var(--font-saira);
    font-size: clamp(3rem, 6vw, 4.5rem);
    font-weight: 800;
    line-height: 1.05;
    text-transform: uppercase;
    margin: 0 0 1.5rem 0;
    letter-spacing: -0.5px;
  }

  .text-blue {
    color: var(--brand-blue);
  }

  .hero-desc {
    color: var(--brand-gray);
    font-size: 1.2rem;
    max-width: 680px;
    line-height: 1.6;
    margin: 0;
  }

  .container {
    max-width: 1600px;
    margin: 0 auto;
    width: 100%;
  }

  .showcase-wrapper {
    position: relative;
  }

  .capability-row {
    padding: 6rem 2rem;
    overflow: hidden;
  }

  .bg-white {
    background-color: var(--bg-light);
  }

  .bg-slate {
    background-color: var(--bg-light-alt);
  }

  @media (min-width: 900px) {
    .capability-row {
      position: sticky;
      top: 0;
      height: 100vh;
      display: flex;
      align-items: center;
      box-shadow: 0 -15px 40px rgba(0, 0, 0, 0.05);
      padding: 0 2rem;
      overflow-y: auto;
    }
  }

  .split-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }

  .split-grid.reverse .content-col {
    order: 2;
  }

  .split-grid.reverse .image-col {
    order: 1;
  }

  .title-block {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .code-badge {
    font-family: var(--font-saira);
    font-size: 0.85rem;
    color: var(--bg-light);
    background-color: var(--brand-black);
    padding: 0.25rem 0.75rem;
    border-radius: 2px;
    font-weight: 800;
    letter-spacing: 1px;
  }

  .spec-tag {
    font-family: var(--font-saira);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--brand-blue);
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .content-col h2 {
    font-family: var(--font-saira);
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 800;
    color: var(--brand-black);
    text-transform: uppercase;
    margin: 0 0 1.25rem 0;
    line-height: 1.1;
  }

  .description {
    color: var(--brand-gray);
    font-size: 1.1rem;
    line-height: 1.7;
    margin: 0 0 2rem 0;
  }

  .specs-box {
    background-color: var(--bg-light);
    border: 1px solid var(--border-light);
    border-left: 4px solid var(--brand-blue);
    padding: 1.5rem;
    border-radius: 2px;
    margin-bottom: 2rem;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.02);
  }

  .specs-header {
    font-family: var(--font-saira);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--brand-blue);
    letter-spacing: 1px;
    margin-bottom: 1rem;
  }

  .specs-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .specs-list li {
    font-size: 0.95rem;
    color: var(--brand-black);
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-weight: 500;
  }

  .bullet {
    width: 6px;
    height: 6px;
    background-color: var(--brand-blue);
    border-radius: 50%;
    margin-top: 0.4rem;
    flex-shrink: 0;
  }

  .visual-frame {
    position: relative;
    background-color: var(--brand-black);
    padding: 0.5rem;
    border-radius: 2px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
  }

  .visual-frame img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    border-radius: 2px;
    opacity: 0.9;
    transition: opacity 0.3s ease;
  }

  .visual-frame:hover img {
    opacity: 1;
  }

  .corner-cross {
    position: absolute;
    font-family: var(--font-saira);
    font-size: 0.85rem;
    color: var(--brand-blue);
    font-weight: bold;
    z-index: 2;
  }

  .top-left { top: -10px; left: -10px; }
  .top-right { top: -10px; right: -10px; }
  .bottom-left { bottom: -10px; left: -10px; }
  .bottom-right { bottom: -10px; right: -10px; }

  .tactical-btn {
    font-family: var(--font-saira);
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    background-color: var(--brand-blue);
    color: var(--bg-light);
    padding: 0.9rem 1.75rem;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 1px;
    border-radius: 2px;
    transition: background-color 0.2s ease;
  }

  .tactical-btn:hover {
    background-color: var(--brand-blue-hover);
  }

  .btn-arrow {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .tactical-btn:hover .btn-arrow {
    transform: translateX(4px);
  }

  .bottom-callout {
    position: relative;
    z-index: 100;
    background-color: var(--brand-black);
    padding: 6rem 2rem;
    border-top: 1px solid var(--border-dark);
    box-shadow: 0 -15px 40px rgba(0, 0, 0, 0.2);
  }

  .callout-box {
    background-color: var(--bg-dark-card);
    border: 1px solid var(--border-dark);
    padding: 3.5rem 2.5rem;
    text-align: center;
  }

  .callout-box h2 {
    font-family: var(--font-saira);
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 800;
    color: var(--bg-light);
    text-transform: uppercase;
    margin: 0.5rem 0 1rem 0;
  }

  .callout-box p {
    color: var(--brand-gray);
    font-size: 1.1rem;
    max-width: 680px;
    margin: 0 auto 2rem auto;
    line-height: 1.6;
  }

  .btn-primary {
    font-family: var(--font-saira);
    display: inline-block;
    background-color: var(--brand-blue);
    color: var(--bg-light);
    padding: 0.9rem 2.25rem;
    text-decoration: none;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.9rem;
    letter-spacing: 1px;
    border-radius: 2px;
    transition: background-color 0.2s ease;
  }

  .btn-primary:hover {
    background-color: var(--brand-blue-hover);
  }

  @media (max-width: 900px) {
    .capability-row {
      padding: 3.5rem 1.5rem;
    }

    .split-grid, .split-grid.reverse {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    
    .split-grid.reverse .content-col {
      order: 1;
    }
    
    .split-grid.reverse .image-col {
      order: 2;
    }
  }
</style>