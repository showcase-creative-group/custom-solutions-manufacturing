---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    id: "conveyor-system",
    title: "Automated Material Handling System",
    image: "https://placehold.co/800x600/050505/ffffff?text=Automated+Conveyor+System"
  },
  {
    id: "titanium-components",
    title: "Titanium Aerospace Flight Mounts",
    image: "https://placehold.co/800x600/050505/ffffff?text=Titanium+Flight+Mounts"
  },
  {
    id: "robotic-welding-cell",
    title: "Robotic Welding Assembly Cell",
    image: "https://placehold.co/800x600/050505/ffffff?text=Robotic+Welding+Cell"
  },
  {
    id: "cleanroom-chassis",
    title: "Semiconductor Vacuum Enclosure",
    image: "https://placehold.co/800x600/050505/ffffff?text=Vacuum+Enclosure+Assembly"
  },
  {
    id: "server-racking-grid",
    title: "Data Center Structural Racking Grid",
    image: "https://placehold.co/800x600/050505/ffffff?text=Data+Center+Rack+Grid"
  },
  {
    id: "eoat-tooling",
    title: "Custom End-of-Arm Tooling (EOAT)",
    image: "https://placehold.co/800x600/050505/ffffff?text=Robotic+EOAT+Tooling"
  },
  {
    id: "hydraulic-manifold",
    title: "Custom Hydraulic Valve Manifold",
    image: "https://placehold.co/800x600/050505/ffffff?text=Hydraulic+Valve+Manifold"
  },
  {
    id: "inspection-fixture",
    title: "CMM Metrology Checking Fixture",
    image: "https://placehold.co/800x600/050505/ffffff?text=CMM+Checking+Fixture"
  },
  {
    id: "plc-control-panel",
    title: "UL 508A Industrial Control Panel",
    image: "https://placehold.co/800x600/050505/ffffff?text=UL+Control+Panel"
  },
  {
    id: "spindle-rebuild",
    title: "High-Speed CNC Spindle Rebuild",
    image: "https://placehold.co/800x600/050505/ffffff?text=CNC+Spindle+Rebuild"
  },
  {
    id: "stamping-die",
    title: "Progressive Sheet Metal Stamping Die",
    image: "https://placehold.co/800x600/050505/ffffff?text=Progressive+Stamping+Die"
  },
  {
    id: "gantry-robot",
    title: "Overhead 3-Axis Cartesian Gantry",
    image: "https://placehold.co/800x600/050505/ffffff?text=Cartesian+Gantry+Robot"
  }
];
---

<Layout title="Case Studies & Projects | Custom Solutions Manufacturing">
  <section class="hero-section">
    <div class="container">
      <span class="sys-tag">[ CASE STUDIES & ARCHIVE ]</span>
      <h1>FEATURED<br/><span class="text-blue">PROJECT BUILDS</span></h1>
      <p class="hero-desc">
        Explore recent custom machinery builds, multi-axis machining applications, and turnkey industrial system integrations.
      </p>
    </div>
  </section>

  <section class="showcase-section">
    <div class="container">
      <div class="projects-grid">
        {projects.map((project) => (
          <article class="project-card">
            <div class="visual-frame">
              <div class="corner-cross top-left">+</div>
              <div class="corner-cross top-right">+</div>
              <div class="corner-cross bottom-left">+</div>
              <div class="corner-cross bottom-right">+</div>
              
              <img src={project.image} alt={project.title} loading="lazy" />
              
              <div class="overlay-content">
                <h2>{project.title}</h2>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bottom-callout">
    <div class="container">
      <div class="callout-box">
        <span class="sys-tag">// HAVE A SPECIFIC SPECIFICATION?</span>
        <h2>READY TO DISCUSS YOUR CUSTOM BUILD?</h2>
        <p>Our engineering, multi-axis machining, and automation assembly teams are ready to review your CAD files and project specifications.</p>
        <a href="/contact" class="btn-primary">SUBMIT PROJECT CAD / DRAWINGS</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero-section {
    background-color: var(--bg-dark);
    color: var(--bg-light);
    padding: 10rem 2rem 4rem 2rem;
    position: relative;
    border-bottom: 2px solid var(--brand-blue);
  }

  .sys-tag {
    font-family: var(--font-saira);
    color: var(--brand-blue);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 2px;
    margin-bottom: 1rem;
    display: block;
  }

  .hero-section h1 {
    font-family: var(--font-saira);
    font-size: clamp(3rem, 6vw, 4.5rem);
    font-weight: 800;
    line-height: 1.05;
    text-transform: uppercase;
    margin: 0 0 1.5rem 0;
    letter-spacing: -0.5px;
  }

  .text-blue {
    color: var(--brand-blue);
  }

  .hero-desc {
    color: var(--brand-gray);
    font-size: 1.2rem;
    max-width: 680px;
    line-height: 1.6;
    margin: 0;
  }

  .container {
    max-width: 1600px;
    margin: 0 auto;
    width: 100%;
  }

  .showcase-section {
    background-color: var(--bg-light);
    padding: 5rem 2rem;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .project-card {
    position: relative;
    border-radius: 2px;
    overflow: hidden;
  }

  .visual-frame {
    position: relative;
    background-color: var(--brand-black);
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid var(--border-light);
  }

  .visual-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .project-card:hover .visual-frame img {
    transform: scale(1.05);
  }

  .corner-cross {
    position: absolute;
    font-family: var(--font-saira);
    font-size: 0.85rem;
    color: var(--brand-blue);
    font-weight: bold;
    z-index: 3;
    pointer-events: none;
  }

  .top-left { top: 8px; left: 10px; }
  .top-right { top: 8px; right: 10px; }
  .bottom-left { bottom: 8px; left: 10px; }
  .bottom-right { bottom: 8px; right: 10px; }

  .overlay-content {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.85);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    text-align: center;
    z-index: 2;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .project-card:hover .overlay-content {
    opacity: 1;
  }

  .overlay-content h2 {
    font-family: var(--font-saira);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--bg-light);
    text-transform: uppercase;
    margin: 0;
    line-height: 1.3;
    letter-spacing: 0.5px;
  }

  .bottom-callout {
    position: relative;
    z-index: 100;
    background-color: var(--brand-black);
    padding: 6rem 2rem;
    border-top: 1px solid var(--border-dark);
  }

  .callout-box {
    background-color: var(--bg-dark-card);
    border: 1px solid var(--border-dark);
    padding: 3.5rem 2.5rem;
    text-align: center;
  }

  .callout-box h2 {
    font-family: var(--font-saira);
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 800;
    color: var(--bg-light);
    text-transform: uppercase;
    margin: 0.5rem 0 1rem 0;
  }

  .callout-box p {
    color: var(--brand-gray);
    font-size: 1.1rem;
    max-width: 680px;
    margin: 0 auto 2rem auto;
    line-height: 1.6;
  }

  .btn-primary {
    font-family: var(--font-saira);
    display: inline-block;
    background-color: var(--brand-blue);
    color: var(--bg-light);
    padding: 0.9rem 2.25rem;
    text-decoration: none;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.9rem;
    letter-spacing: 1px;
    border-radius: 2px;
    transition: background-color 0.2s ease;
  }

  .btn-primary:hover {
    background-color: var(--brand-blue-hover);
  }

  @media (max-width: 900px) {
    .projects-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .overlay-content {
      opacity: 1;
      background-color: rgba(0, 0, 0, 0.7);
      padding: 1.5rem;
    }
  }
</style>